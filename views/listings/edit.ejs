<%-layout("/layouts/boilerplate")%>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <br>

            <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div>
                    <h1>Edit Your Listing</h1>
                </div>
                <div class="mb-3"> <label for="title" class="form-label">Title</label>
                    <input value="<%=listing.title%>" type="text" name="listing[title]" class="form-control" required><br>
                </div>
                <div class="mb-3"> <label for="description" class="form-label">Description</label>
                    <textarea placeholder="Enter Decription" name="listing[description]" row="10"
                        cols="30" class="form-control" required><%=listing.description%></textarea>
                </div>
                <div class="edit-img-preview mb-3">
                    <img src="<%=originalImageUrl%>" alt="<%=listing.image.filename%>">
                </div>
                <div class="mb-3"><label for="image" class="form-label">Upload New Image</label>
                    <input  type="file" name="listing[image][url]" class="form-control" ><br>
                </div>
               <div class="row">
                 <div class="mb-3 col-md-4"><label for="price" class="form-label"> Price</label>
                    <input value="<%=listing.price%>" type="number" name="listing[price]" class="form-control" required><br>
                </div>
                <div class="mb-3 col-md-8"><label for="country">Country</label>
                    <input value="<%=listing.country%>" type="text" name="listing[country]" class="form-control" required><br>
                </div>
               </div>
                <div class="mb-3"><label for="location" class="form-label">Location</label>
                    <input value="<%=listing.location%>" type="text" name="listing[location]" class="form-control" required><br>
                </div>
                <button class="btn btn-lg add-btn">Edit</button>
            </form>
            
            </div>
        </div>